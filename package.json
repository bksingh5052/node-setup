{
    "name": "js-setup",
    "version": "1.0.0",
    "type": "module",
    "main": "src/server.js",
    "scripts": {
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "formate:check": "prettier . --check",
        "formate:fix": "prettier . --write",
        "dev": "cross-env NODE_ENV=development nodemon --legacy-watch src/server.js",
        "start": "cross-env NODE_ENV=production node src/server.js",
        "prepare": "husky"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "lint-staged": {
        "*.js": [
            "npm run lint:fix",
            "npm run formate:fix"
        ]
    },
    "description": "",
    "devDependencies": {
        "@commitlint/cli": "^21.0.1",
        "@commitlint/config-conventional": "^21.0.1",
        "@eslint/js": "^10.0.1",
        "eslint": "^10.4.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.6.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "nodemon": "^3.1.14",
        "prettier": "^3.8.3"
    },
    "dependencies": {
        "colorette": "^2.0.20",
        "cors": "^2.8.6",
        "cross-env": "^10.1.0",
        "dotenv-flow": "^4.1.0",
        "express": "^5.2.1",
        "helmet": "^8.2.0",
        "mongoose": "^9.6.2",
        "path": "^0.12.7",
        "rate-limiter-flexible": "^11.1.0",
        "winston": "^3.19.0",
        "winston-mongodb": "^7.0.1"
    }
}
